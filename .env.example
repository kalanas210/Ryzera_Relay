# Copy to .env to change any of these. `docker compose up` works without a .env file.

RELAY_PORT=8080

POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# Signs the session cookies. On a shared server make it long and random, for example with this.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RELAY_SECRET_KEY=local-only-secret-change-me-before-deploying

# Password for every seeded account. Loaders sign in with their PIN instead.
RELAY_SEED_PASSWORD=relay2026

# Turns on the demo bar with the scenario clock, private copies of the day and reset.
RELAY_DEMO_MODE=true

# Production only. The public domain Caddy gets a certificate for, and secure cookies.
# SITE_ADDRESS=relay.example.com
# RELAY_COOKIE_SECURE=true
