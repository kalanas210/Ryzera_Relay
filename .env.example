# Copy to .env to change any of these. `docker compose up` works without a .env file.

# Port the app is served on: http://localhost:8080
RELAY_PORT=8080

# Database
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# Signs session cookies. Use a long random value on any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RELAY_SECRET_KEY=local-only-secret-change-me

# Password of every seeded account (see the README for the accounts). Loaders use their PIN.
RELAY_SEED_PASSWORD=relay2026

# Shows the demo bar: the scenario clock, private copies of the day, and reset.
RELAY_DEMO_MODE=true

# Production only: the public domain Caddy gets an HTTPS certificate for, and secure cookies.
# SITE_ADDRESS=relay.example.com
# RELAY_COOKIE_SECURE=true
