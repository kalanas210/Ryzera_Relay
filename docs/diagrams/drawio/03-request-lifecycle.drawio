<mxfile host="app.diagrams.net" agent="Relay diagrams" version="24.0.0"><diagram name="What happens to one request" id="p1"><mxGraphModel dx="1840" dy="1464" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="1464" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1840" height="1464" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;What happens to one request&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1760" height="34" as="geometry"/></mxCell><mxCell id="c3" value="The numbered path from a browser to the database and back. A red box is the answer a failing check sends, and the request ends there." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1760" height="22" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;The browser sends the request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Headers X-Relay-Client and X-Relay-Role, added by apps/web/src/api/client.ts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Cookies: relay_ws and the cookie of the role the screen acts as&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="700" height="70" as="geometry"/></mxCell><mxCell id="c4" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="154" width="22" height="22" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Caddy 2, the web container&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;apps/web/Caddyfile. Passes /api/* on to api:8000&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;On the way back it compresses with zstd or gzip and adds three security headers&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="700" height="80" as="geometry"/></mxCell><mxCell id="c5" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="269" width="22" height="22" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;413&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;A request body over 2 MB on /api is&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;turned away before the API reads it&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="240" width="460" height="80" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:14px&quot;&gt;api: one FastAPI process on Uvicorn&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="780" height="784" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;LimitBody middleware&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;main.py. Refuses a body over 2,000,000 bytes, by Content-Length or by counting what it reads&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="40" y="40" width="700" height="70" as="geometry"/></mxCell><mxCell id="c8" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="424" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;413&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Answers &quot;This is too large for Relay to take.&quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The same cap as Caddy, kept in the API&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="460" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="&lt;b&gt;require_client_header, for every route&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;security.py, set on the app in main.py. POST, PUT, PATCH and DELETE must carry X-Relay-Client&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="40" y="138" width="700" height="70" as="geometry"/></mxCell><mxCell id="c11" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="522" width="22" height="22" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;403&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Missing client header&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;A cross-site form or image cannot send a custom header&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="498" width="460" height="70" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;get_scope: which copy of the day&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;workspaces.py. The relay_ws cookie names the copy. No cookie or an unknown code means MAIN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;MAIN goes back to the start if it was changed and nobody used it for an hour&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Notes who is using the copy, then scopes the database session to it&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="40" y="236" width="700" height="90" as="geometry"/></mxCell><mxCell id="c14" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="630" width="22" height="22" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;503&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The database has not been seeded yet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;There is no MAIN copy to fall back to&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="596" width="460" height="90" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;require(Role.X): who is asking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;security.py. The role is X-Relay-Role (a photo uses ?as=). No role named means dispatcher&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Reads that role's cookie: relay_dsp, relay_ldr, relay_drv or relay_stm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Decodes the token, reloads the user, and the user's role must match&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="40" y="354" width="700" height="90" as="geometry"/></mxCell><mxCell id="c17" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="748" width="22" height="22" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;401, 403 or 400&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;401: no cookie for that role, or a bad or expired token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;403: the route is for another role&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;400: X-Relay-Role names no role&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="714" width="460" height="90" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7" value="&lt;b&gt;Router: the route's function&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;routers/*.py. Pydantic checks the body, then the route looks up the rows it names&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;It turns the service's errors into HTTP answers&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="40" y="472" width="700" height="80" as="geometry"/></mxCell><mxCell id="c20" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="861" width="22" height="22" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;404, 409 or 422&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;404: a row the route names is not there&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;409: MAIN's clock or reset (the /api/demo routes)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;422: the body or a rule of the route fails&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="832" width="460" height="80" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s8" value="&lt;b&gt;Service: the domain logic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;services/*.py. One module per concern. Calls relay_engine for plans, rules and estimates&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Reads the time from the copy's own scenario clock, Scope.now&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="40" y="580" width="700" height="70" as="geometry"/></mxCell><mxCell id="c23" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="964" width="22" height="22" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;409&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The service refuses: DockError, PlanError,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;OrderClosed or BackupError, and the router says 409&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="940" width="460" height="70" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s8" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s9" value="&lt;b&gt;ORM hook: every query stays in the copy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;db.py. do_orm_execute adds workspace_id = :id to every select, update and delete&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;on the 23 per-copy tables, and before_flush stamps workspace_id on new rows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Raw SQL would skip it, so the services use the ORM throughout&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="40" y="678" width="700" height="90" as="geometry"/></mxCell><mxCell id="c26" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="1072" width="22" height="22" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;404 for another copy's id&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The hook hides it, so the lookup finds no row&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;tests/test_dock.py checks this on a second copy&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="1038" width="460" height="90" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B3261E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s10" value="&lt;b&gt;PostgreSQL 16, and the commit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The statements run here. The route calls db.commit() when its service call is done&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;43 tables: 20 shared by all copies, 23 with a workspace_id&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="80" y="1204" width="700" height="80" as="geometry"/></mxCell><mxCell id="c29" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="1233" width="22" height="22" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;The answer goes back to the browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The route's response model goes back as JSON, a photo as image bytes, through Caddy again&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Caddy compresses it with zstd or gzip and adds the security headers&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="80" y="1344" width="700" height="80" as="geometry"/></mxCell><mxCell id="c30" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="1373" width="22" height="22" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="scoped SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0A6EBD;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="rows, then JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="facts" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cookies and sign-in&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;held by the browser&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="400" height="428" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;relay_ws&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Names the copy of the day, kept 30 days&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Set when a private copy is made or joined&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;No cookie means the shared MAIN copy&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="facts"><mxGeometry x="20" y="44" width="360" height="80" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Every cookie&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;httpOnly, SameSite=Lax, path /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Secure in production (RELAY_COOKIE_SECURE)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="facts"><mxGeometry x="20" y="140" width="360" height="70" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;A role's session token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;HS256, signed with the server's secret key&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Holds the user id and the role, issued and expiry&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Lasts 12 hours. The user is reloaded on every request&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="facts"><mxGeometry x="20" y="226" width="360" height="90" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Passwords and PINs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stored only as Argon2id hashes (security.py)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Checked at /api/auth/login and /api/auth/pin&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="facts"><mxGeometry x="20" y="332" width="360" height="80" as="geometry"/></mxCell><mxCell id="roles" value="&lt;b style=&quot;font-size:14px&quot;&gt;Role checks&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;which cookie, which routes&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="1400" y="590" width="400" height="452" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;relay_dsp, every route under /api/dispatch&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="roles"><mxGeometry x="20" y="44" width="360" height="50" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Loader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;relay_ldr, every route under /api/dock&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="roles"><mxGeometry x="20" y="106" width="360" height="50" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;relay_drv, every route under /api/driver&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="roles"><mxGeometry x="20" y="168" width="360" height="50" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Store manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;relay_stm, every route under /api/store&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="roles"><mxGeometry x="20" y="230" width="360" height="50" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Photos, /api/photos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Any signed-in role, named with ?as=&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;A photo you may not see reads as 404&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="roles"><mxGeometry x="20" y="292" width="360" height="66" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;No role check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Sign-in and sign-out, /api/health, the API docs,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;/api/demo and the list of demo accounts&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;fontColor=#69727F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="roles"><mxGeometry x="20" y="370" width="360" height="66" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1400" y="1302" width="22" height="16" as="geometry"/></mxCell><mxCell id="c52" value="Browser" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1432" y="1301" width="320" height="18" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=