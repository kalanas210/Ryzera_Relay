<mxfile host="app.diagrams.net" agent="Relay diagrams" version="24.0.0"><diagram name="How the phone keeps working" id="p1"><mxGraphModel dx="1840" dy="1270" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="1270" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1840" height="1270" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;How a driver's phone keeps working with no signal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1760" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Every action is saved on the phone first and sent later with its own id, so Relay ends up with the right records." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1760" height="22" as="geometry"/></mxCell><mxCell id="phone" value="&lt;b style=&quot;font-size:14px&quot;&gt;On the driver's phone&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;outbox.ts and sync.tsx&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;strokeWidth=1.2;fontColor=#0A4450;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="480" height="990" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:14px&quot;&gt;In the API&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;services/field.py&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="560" height="710" as="geometry"/></mxCell><mxCell id="clash" value="&lt;b style=&quot;font-size:14px&quot;&gt;The clash branch&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;stop moved to a backup, or cancelled&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FEF8EE;strokeColor=#A15C00;strokeWidth=1.2;fontColor=#A15C00;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="1260" y="140" width="540" height="710" as="geometry"/></mxCell><mxCell id="band" value="&lt;b style=&quot;font-size:14px&quot;&gt;Meanwhile, with no signal&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;GET /api/dispatch/live/runs and GET /api/store/orders/ORDER/tracker read one rule&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="620" y="890" width="1180" height="240" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;The driver acts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Arrived, Complete stop, Send report or an answer&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="phone"><mxGeometry x="20" y="50" width="440" height="60" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Saved to IndexedDB first&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;id: a UUID made on the phone&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;occurred_at: the scenario time, stamped now&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;base_version: the stop version the phone last saw&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="phone"><mxGeometry x="20" y="160" width="440" height="150" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Waits up to 15 s for one location reading&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The time is already saved. Only the send waits.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="phone"><mxGeometry x="20" y="360" width="440" height="90" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Sender: one run at a time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;All waiting records go in one POST, in saved order,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;then each photo in its own PUT.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="phone"><mxGeometry x="20" y="500" width="440" height="110" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;No signal: the record stays queued&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Nothing leaves the queue until Relay answers.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The sender tries again when the browser is online,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the app comes to the front, a record is saved,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;and with the check-in each minute.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="phone"><mxGeometry x="20" y="690" width="440" height="150" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;Answered: it leaves the queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Kept as sent, with the outcome Relay gave.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="phone"><mxGeometry x="20" y="900" width="440" height="70" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#69727F;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="tries again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#69727F;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a1" value="&lt;b&gt;POST /api/driver/records&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;First notes the phone's contact (device_contact, row locked),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;then takes the records in the order sent.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="20" y="50" width="520" height="80" as="geometry"/></mxCell><mxCell id="frame" value="&lt;b style=&quot;font-size:14px&quot;&gt;Each record in its own savepoint&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;one bad record never stops the batch&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="api"><mxGeometry x="20" y="170" width="520" height="270" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;duplicate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The id is already stored, so the resend changes nothing.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="frame"><mxGeometry x="20" y="50" width="230" height="90" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;rejected&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Not this driver's vehicle, a wrong stop, or a time in the future. Kept with its reason.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="frame"><mxGeometry x="270" y="50" width="230" height="90" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;applied&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;A delivery sets the stop delivered at the phone's time, saves the proof and tells the store.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="frame"><mxGeometry x="20" y="160" width="230" height="90" as="geometry"/></mxCell><mxCell id="o4" value="&lt;b&gt;conflict&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The office moved the stop to a backup, or cancelled it, after the version the phone saw.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="frame"><mxGeometry x="270" y="160" width="230" height="90" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;PUT /api/driver/photos/ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stored by its own id. A resend is answered duplicate.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;A new photo joins its stop's proof.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="20" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;One outcome per record id, and the run as Relay now has it.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="api"><mxGeometry x="20" y="620" width="520" height="70" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="frame"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frame" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.346;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="records&lt;br&gt;in order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F5563;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="a1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="662"/><mxPoint x="570" y="230"/></Array></mxGeometry></mxCell><mxCell id="c13" value="then photos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F5563;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.2727272727272727;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="one outcome&lt;br&gt;per id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F5563;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="p6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="795"/><mxPoint x="580" y="1075"/></Array></mxGeometry></mxCell><mxCell id="cl1" value="&lt;b&gt;Keep the driver's record&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stored as conflict, with its proof for a delivery. The&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;stop is not marked delivered and the store is not told.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="clash"><mxGeometry x="20" y="50" width="500" height="80" as="geometry"/></mxCell><mxCell id="cl2" value="&lt;b&gt;Open one question to the driver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;One conflict row per stop, waiting_for_driver.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;It reaches the phone in the run Relay sends back.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="clash"><mxGeometry x="20" y="170" width="500" height="80" as="geometry"/></mxCell><mxCell id="cl3" value="&lt;b&gt;Add one item to the dispatcher's feed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;For example: Stop 4 has two copies.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The body says Relay has asked the driver.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="clash"><mxGeometry x="20" y="290" width="500" height="80" as="geometry"/></mxCell><mxCell id="cl4" value="&lt;b&gt;First answer wins&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Driver: a conflict_answer record, sent through the outbox.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Dispatcher: Settle on the feed item, at any time.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="clash"><mxGeometry x="20" y="410" width="500" height="80" as="geometry"/></mxCell><mxCell id="cl5" value="&lt;b&gt;The driver's delivery stands&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stop delivered at the phone's time. The backup's copy is cancelled and the store is told.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="clash"><mxGeometry x="20" y="560" width="240" height="120" as="geometry"/></mxCell><mxCell id="cl6" value="&lt;b&gt;Escalated to the dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The driver said no, or 10 minutes passed with no answer. The backup carries on.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="clash"><mxGeometry x="280" y="560" width="240" height="120" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl1" target="cl2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl2" target="cl3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl3" target="cl4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.24;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl4" target="cl5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="no, or&lt;br&gt;10 minutes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.76;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl4" target="cl6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A15C00;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o4" target="cl1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="515"/><mxPoint x="1220" y="230"/></Array></mxGeometry></mxCell><mxCell id="e1" value="&lt;b&gt;One estimate rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;relay_engine/estimate.py,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;fed by services/estimates.py&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="band"><mxGeometry x="30" y="70" width="250" height="130" as="geometry"/></mxCell><mxCell id="shown" value="&lt;b style=&quot;font-size:14px&quot;&gt;The dispatcher's Live runs and the store's tracker show&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;strokeWidth=1.2;fontColor=#0A4450;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="band"><mxGeometry x="340" y="50" width="820" height="170" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Last contact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The phone's last record or check-in. After 5 minutes on a running trip: No contact.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="shown"><mxGeometry x="20" y="50" width="180" height="110" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;An estimate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;From the last stop event, to 5 minutes. Time passing never pushes it later.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="shown"><mxGeometry x="220" y="50" width="180" height="110" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;A likely range&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;15 minutes either side plus half of each silent minute, never before now.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="shown"><mxGeometry x="420" y="50" width="180" height="110" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;No reason given&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Relay cannot tell a lost signal from a flat battery, so it never guesses.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="shown"><mxGeometry x="620" y="50" width="180" height="110" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C99700;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e1" target="shown"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="178" width="22" height="22" as="geometry"/></mxCell><mxCell id="c23" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="288" width="22" height="22" as="geometry"/></mxCell><mxCell id="c24" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="488" width="22" height="22" as="geometry"/></mxCell><mxCell id="c25" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="628" width="22" height="22" as="geometry"/></mxCell><mxCell id="c26" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628" y="178" width="22" height="22" as="geometry"/></mxCell><mxCell id="c27" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628" y="298" width="22" height="22" as="geometry"/></mxCell><mxCell id="c28" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628" y="748" width="22" height="22" as="geometry"/></mxCell><mxCell id="c29" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="1028" width="22" height="22" as="geometry"/></mxCell><mxCell id="c30" value="The phone's own time is kept. A delivery saved at 6:36 AM and sent at 7:14 AM reads 6:36 AM everywhere." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c31" value="A record leaves the phone's queue only when Relay answers it, and Relay applies each id once, so a resend is harmless." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="1202" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1400" y="1168" width="22" height="16" as="geometry"/></mxCell><mxCell id="c33" value="Saved on the phone" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1432" y="1167" width="170" height="18" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1400" y="1194" width="22" height="16" as="geometry"/></mxCell><mxCell id="c35" value="The estimate rule" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1432" y="1193" width="170" height="18" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1400" y="1220" width="22" height="16" as="geometry"/></mxCell><mxCell id="c37" value="Applied" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1432" y="1219" width="170" height="18" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1600" y="1168" width="22" height="16" as="geometry"/></mxCell><mxCell id="c39" value="Clash" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1632" y="1167" width="170" height="18" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#B3261E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1600" y="1194" width="22" height="16" as="geometry"/></mxCell><mxCell id="c41" value="Refused" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1632" y="1193" width="170" height="18" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1600" y="1220" width="22" height="16" as="geometry"/></mxCell><mxCell id="c43" value="Waiting, or nothing to do" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1632" y="1219" width="170" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="One storm, 93 minutes" id="p2"><mxGraphModel dx="1840" dy="1080" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1840" height="1080" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;One storm, 93 minutes without signal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1760" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Wednesday 8 April 2026, VEH045. Kasun keeps delivering, the office reads estimates, and the records catch up at 7:14 AM." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1760" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;5:41 AM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;signal lost&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;