t=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="912" y="130" width="160" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;6:42 AM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;receipt in&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="160" height="44" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;7:09 AM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;stop 4 saved&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1268" y="130" width="160" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;7:14 AM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;signal back&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1446" y="130" width="160" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;7:15 AM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;answer&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1624" y="130" width="160" height="44" as="geometry"/></mxCell><mxCell id="silent" value="&lt;b&gt;No signal for 93 minutes, 5:41 to 7:14 AM&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="190" width="1246" height="34" as="geometry"/></mxCell><mxCell id="phone" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;strokeWidth=1.2;fontColor=#0A4450;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1760" height="136" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Kasun's phone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;driver, VEH045&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="54" y="308" width="130" height="60" as="geometry"/></mxCell><mxCell id="relay" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#0A6EBD;strokeWidth=1.2;fontColor=#0A6EBD;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1760" height="136" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Relay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;what it holds&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="54" y="498" width="130" height="60" as="geometry"/></mxCell><mxCell id="desk" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;strokeWidth=1.2;fontColor=#0A4450;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1760" height="136" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Nuwan, Live runs&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="54" y="688" width="130" height="60" as="geometry"/></mxCell><mxCell id="store" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;strokeWidth=1.2;fontColor=#0A4450;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1760" height="136" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Store managers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Hemmathagama, Aranayake&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="54" y="878" width="130" height="60" as="geometry"/></mxCell><mxCell id="phone0" value="&lt;b&gt;Signal lost&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Kasun is unloading at Mawanella. The app carries on.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="200" y="280" width="160" height="116" as="geometry"/></mxCell><mxCell id="phone1" value="&lt;b&gt;Stop 2 delivered&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Saved in the outbox, waiting to send.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="378" y="280" width="160" height="116" as="geometry"/></mxCell><mxCell id="phone3" value="&lt;b&gt;Cannot see the move&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Notices wait until the phone is in contact.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="734" y="280" width="160" height="116" as="geometry"/></mxCell><mxCell id="phone4" value="&lt;b&gt;Stop 3 delivered&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Arrived 6:21. Both saved in the outbox.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="912" y="280" width="160" height="116" as="geometry"/></mxCell><mxCell id="phone6" value="&lt;b&gt;Stop 4 delivered&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Arrived 6:56. Both saved in the outbox.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1268" y="280" width="160" height="116" as="geometry"/></mxCell><mxCell id="phone7" value="&lt;b&gt;Signal back&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Sends 5 records in saved order, then 2 photos.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1446" y="280" width="160" height="116" as="geometry"/></mxCell><mxCell id="phone8" value="&lt;b&gt;Answers yes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Saved first, then sent like any record.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1624" y="280" width="160" height="116" as="geometry"/></mxCell><mxCell id="relay0" value="&lt;b&gt;Last contact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;5:41. Nothing more arrives.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="200" y="470" width="160" height="116" as="geometry"/></mxCell><mxCell id="relay2" value="&lt;b&gt;24 minutes silent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stop 2 still reads arrived 5:30. The delivery is on the phone.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="556" y="470" width="160" height="116" as="geometry"/></mxCell><mxCell id="relay3" value="&lt;b&gt;Stop 4 changes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Moved to VEH060. Its version goes up.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="734" y="470" width="160" height="116" as="geometry"/></mxCell><mxCell id="relay5" value="&lt;b&gt;Receipt counts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stop 3 counts as delivered for every estimate after it.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1090" y="470" width="160" height="116" as="geometry"/></mxCell><mxCell id="relay7" value="&lt;b&gt;Stop 4 clashes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stops 2 and 3 apply at the phone's times. Stop 4 is kept and one question is opened.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1446" y="470" width="160" height="116" as="geometry"/></mxCell><mxCell id="relay8" value="&lt;b&gt;Settled&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Stop 4 delivered 7:09. VEH060's copy is cancelled.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1624" y="470" width="160" height="116" as="geometry"/></mxCell><mxCell id="desk2" value="&lt;b&gt;No contact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Since 5:41. Stop 3 around 6:35, likely 6:05 to 7:05. Stop 4 around 7:15.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="556" y="660" width="160" height="116" as="geometry"/></mxCell><mxCell id="desk3" value="&lt;b&gt;Moves stop 4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Sends the standby van VEH060 as a backup.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="734" y="660" width="160" height="116" as="geometry"/></mxCell><mxCell id="desk5" value="&lt;b&gt;Keeps the backup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;At 6:44, after the receipt. Kasun is still silent.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1090" y="660" width="160" height="116" as="geometry"/></mxCell><mxCell id="desk7" value="&lt;b&gt;Two copies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Feed item: Stop 4 has two copies. Kasun is back in contact.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1446" y="660" width="160" height="116" as="geometry"/></mxCell><mxCell id="desk8" value="&lt;b&gt;Conflict resolved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;The feed item closes. VEH060 turns back.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1624" y="660" width="160" height="116" as="geometry"/></mxCell><mxCell id="store2" value="&lt;b&gt;Estimate and range&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Hemmathagama sees around 6:35, likely 6:05 to 7:05. Last heard 5:41.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="556" y="850" width="160" height="116" as="geometry"/></mxCell><mxCell id="store5" value="&lt;b&gt;Confirms receipt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Dilani confirms for Hemmathagama before any proof.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1090" y="850" width="160" height="116" as="geometry"/></mxCell><mxCell id="store7" value="&lt;b&gt;Proof joins receipt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Delivered 6:36, sent 7:14.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1446" y="850" width="160" height="116" as="geometry"/></mxCell><mxCell id="store8" value="&lt;b&gt;Aranayake is told&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Delivered 7:09, proof attached. The backup is cancelled.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1624" y="850" width="160" height="116" as="geometry"/></mxCell><mxCell id="c17" value="in saved order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F5563;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="phone7" target="relay7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="the answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F5563;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="phone8" target="relay8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="relay7" target="desk7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="relay8" target="desk8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Times are scenario time. Every record keeps the time it happened on the phone, not the time it arrived." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c22" value="" 