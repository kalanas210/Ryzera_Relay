<mxfile host="app.diagrams.net" agent="Relay diagrams" version="24.0.0"><diagram name="Database overview" id="p1"><mxGraphModel dx="1820" dy="930" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1820" pageHeight="930" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1820" height="930" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;The database in one picture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1740" height="34" as="geometry"/></mxCell><mxCell id="c3" value="43 tables in PostgreSQL 16. Twenty are shared by every copy of the day, twenty-three belong to one copy each." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1740" height="22" as="geometry"/></mxCell><mxCell id="shared" value="&lt;b style=&quot;font-size:14px&quot;&gt;Shared by every copy&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;20 tables&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1740" height="270" as="geometry"/></mxCell><mxCell id="copy" value="&lt;b styl