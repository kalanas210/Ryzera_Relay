Fill=1;html=1;strokeColor=#69727F;strokeWidth=1.5;startArrow=none;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="196" as="sourcePoint"/><mxPoint x="1110" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ln10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#69727F;strokeWidth=1.5;startArrow=none;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="196" as="sourcePoint"/><mxPoint x="1740" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="overnight" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1110" y="170" width="60" height="18" as="geometry"/></mxCell><mxCell id="lane_d_210" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1720" height="160" as="geometry"/></mxCell><mxCell id="head_d_210" value="&lt;b&gt;Store manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Dilani&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="110" height="140" as="geometry"/></mxCell><mxCell id="lane_n_210" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1720" height="160" as="geometry"/></mxCell><mxCell id="head_n_210" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Nuwan&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="110" height="140" as="geometry"/></mxCell><mxCell id="lane_r_210" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1720" height="160" as="geometry"/></mxCell><mxCell id="head_r_210" value="&lt;b&gt;Loader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Rizwan&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="110" height="140" as="geometry"/></mxCell><mxCell id="lane_k_210" value="&lt;b style=&quot;font-size:14px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1720" height="160" as="geometry"/></mxCell><mxCell id="head_k_210" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Kasun&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="730" width="110" height="140" as="geometry"/></mxCell><mxCell id="ln11" value="" style="endArrow=none;endFill=1;html=1;strokeColor=#B8BFC9;strokeWidth=1.5;startArrow=none;endSize=6;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="202" as="sourcePoint"/><mxPoint x="1140" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1" value="&lt;b&gt;Places two orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;2:10 and 2:14 PM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Chilled, then dry&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Received by Waypoint&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="180" y="240" width="170" height="100" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Queue locks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;3:12 PM chases stores&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;4:00 PM cutoff locks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;57 Kandy hub orders&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="180" y="410" width="170" height="100" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Relay proposes the Kandy plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;4:35 PM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;56 of 57 orders on&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;18 trips, 1 waits&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="370" y="410" width="170" height="100" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Confirms deferral&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;4:52 PM, Relay's reason&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Kegalle's order waited&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;on Monday, so Dilani's&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;chilled order waits&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="560" y="410" width="170" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Publishes the plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;6:39 PM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Sent to the dock, the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;drivers and every store&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="750" y="410" width="170" height="100" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Reads the notice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;6:41 PM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Chilled order: Thursday&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Dry order: around 5:20 AM&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="750" y="240" width="170" height="100" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;Loading list&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;6:39 PM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Built from the plan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;last stop loads first&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="750" y="580" width="170" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Swaps stops 2 and 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;9:12 PM, VEH045&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Mawanella now stop 2,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Hemmathagama stop 3&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="940" y="410" width="170" height="100" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Told it moves later&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;9:12 PM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Dry order now around&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;6:25 AM, was 5:20&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="940" y="240" width="170" height="100" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Loads VEH045&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;2:40 AM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Banner: stops 2 and 3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;swapped. Stop 4 first&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1170" y="580" wi