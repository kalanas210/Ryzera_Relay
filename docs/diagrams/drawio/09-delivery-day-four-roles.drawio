<mxfile host="app.diagrams.net" agent="Relay diagrams" version="24.0.0"><diagram name="One delivery day, four roles" id="p1"><mxGraphModel dx="1780" dy="1550" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1780" pageHeight="1550" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1780" height="1550" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;One delivery day, four roles&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1700" height="34" as="geometry"/></mxCell><mxCell id="c3" value="From Dilani's order on Tuesday afternoon to Kasun's finished trip on Wednesday morning. Each arrow is a hand-off that reaches another role." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1700" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Orders, plan and dock&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#69727F&quot;&gt;from Dilani's order to Kasun leaving the hub&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1200" height="22" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Tuesday 7 April&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="180" y="150" width="400" height="18" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Wednesday 8 April&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="400" height="18" as="geometry"/></mxCell><mxCell id="c7" value="2:10 to 4:00 PM" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="180" y="170" width="170" height="18" as="geometry"/></mxCell><mxCell id="ln1" value="" style="endArrow=none;endFill=1;html=1;strokeColor=#69727F;strokeWidth=1.5;startArrow=none;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="190" as="sourcePoint"/><mxPoint x="265" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="4:35 PM" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="370" y="170" width="170" height="18" as="geometry"/></mxCell><mxCell id="ln2" value="" style="endArrow=none;endFill=1;html=1;strokeColor=#69727F;strokeWidth=1.5;startArrow=none;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="190" as="sourcePoint"/><mxPoint x="455" y="202" as="targetPo