<mxfile host="app.diagrams.net" agent="Relay diagrams" version="24.0.0"><diagram name="Deployment and delivery" id="p1"><mxGraphModel dx="1840" dy="1170" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="1170" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1840" height="1170" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Where Relay runs and how a change gets there&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1760" height="34" as="geometry"/></mxCell><mxCell id="c3" value="A push starts CI, a person runs deploy.sh, and one server in Mumbai rebuilds the same docker compose stack that judges run locally." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1760" height="22" as="geometry"/></mxCell><mxCell id="push" value="&lt;b&gt;Push to main or open a pull request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Either one starts CI. A newer push to the same branch cancels the run in progress.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="700" height="70" as="geometry"/></mxCell><mxCell id="c4" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="22" height="22" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b style=&quot;font-size:14px&quot;&gt;GitHub Actions CI&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;.github/workflows/ci.yml, four jobs side by side&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3FAF6;strokeColor=#1F7A4D;strokeWidth=1.2;fontColor=#1F7A4D;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="700" height="330" as="geometry"/></mxCell><mxCell id="c5" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="710" y="260" width="22" height="22" as="geometry"/></mxCell><mxCell id="job_py" value="&lt;b&gt;Engine and API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;ruff lint and format check&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;mypy in strict mode&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;pytest against a PostgreSQL 16 service&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ci"><mxGeometry x="20" y="50" width="320" height="120" as="geometry"/></mxCell><mxCell id="job_web" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Biome lint&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Vitest&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;TypeScript check and production build&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ci"><mxGeometry x="360" y="50" width="320" height="120" as="geometry"/></mxCell><mxCell id="job_img" value="&lt;b&gt;Docker images&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;docker compose build&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;every service, built as compose up builds it&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ci"><mxGeometry x="20" y="190" width="320" height="120" as="geometry"/></mxCell><mxCell id="job_e2e" value="&lt;b&gt;Judge walkthrough in a browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;starts the stack and waits until healthy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;waits for the engine cache warm-up&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Playwright walkthrough in Chromium&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;report uploaded if it fails&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ci"><mxGeometry x="360" y="190" width="320" height="120" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;infra/deploy.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;git archive of the committed HEAD, sent over ssh&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;uncommitted work is never deployed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;a person runs it from a developer's machine, CI never deploys&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="700" height="100" as="geometry"/></mxCell><mxCell id="c6" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="22" height="22" as="geometry"/></mxCell><mxCell id="tf" value="&lt;b&gt;infra/terraform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;run once with terraform apply&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;creates the instance, the Elastic IP and the security group&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;cloud-init installs Docker and a 2 GB swap file&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="700" height="100" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="22" height="16" as="geometry"/></mxCell><mxCell id="c8" value="Person or browser" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="72" y="959" width="200" height="18" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="986" width="22" height="16" as="geometry"/></mxCell><mxCell id="c10" value="Automated check in CI" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="72" y="985" width="200" height="18" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="1012" width="22" height="16" as="geometry"/></mxCell><mxCell id="c12" value="Hosting, scripts and jobs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="72" y="1011" width="200" height="18" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="1038" width="22" height="16" as="geometry"/></mxCell><mxCell id="c14" value="Team only, or secrets" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="72" y="1037" width="200" height="18" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="1064" width="22" height="16" as="geometry"/></mxCell><mxCell id="c16" value="Database and its backups" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="72" y="1063" width="200" height="18" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="22" height="16" as="geometry"/></mxCell><mxCell id="c18" value="Relay code" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="72" y="1089" width="200" height="18" as="geometry"/></mxCell><mxCell id="c19" value="A redeploy replaces only the code. The database, the certificates and the secrets live in Docker volumes and /opt/relay/.env, so every judge's private copy of the day survives." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="300" y="962" width="440" height="60" as="geometry"/></mxCell><mxCell id="vis" value="&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;judges and the team, in a browser&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1370" y="140" width="260" height="60" as="geometry"/></mxCell><mxCell id="aws" value="&lt;b style=&quot;font-size:14px&quot;&gt;AWS ap-south-1 (Mumbai)&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;default VPC, built by Terraform&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="920" height="910" as="geometry"/></mxCell><mxCell id="eip" value="&lt;b&gt;Elastic IP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;relay-ryzera.tech and www.relay-ryzera.tech point here&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="aws"><mxGeometry x="360" y="40" width="520" height="70" as="geometry"/></mxCell><mxCell id="sg" value="&lt;b style=&quot;font-size:14px&quot;&gt;Security group relay-web&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;dashed=1;dashPattern=8 5;" vertex="1" parent="aws"><mxGeometry x="20" y="150" width="880" height="150" as="geometry"/></mxCell><mxCell id="p22" value="&lt;b&gt;Port 22, ssh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;team addresses only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;used by deploy.sh&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="sg"><mxGeometry x="20" y="50" width="240" height="80" as="geometry"/></mxCell><mxCell id="p80" value="&lt;b&gt;Port 80&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;open to everyone&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;redirects to HTTPS&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="sg"><mxGeometry x="340" y="50" width="240" height="80" as="geometry"/></mxCell><mxCell id="p443" value="&lt;b&gt;Port 443, tcp and udp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;open to everyone&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;HTTPS and HTTP/3&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="sg"><mxGeometry x="620" y="50" width="240" height="80" as="geometry"/></mxCell><mxCell id="inst" value="&lt;b style=&quot;font-size:14px&quot;&gt;EC2 instance relay&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="aws"><mxGeometry x="20" y="340" width="880" height="550" as="geometry"/></mxCell><mxCell id="c20" value="Ubuntu 24.04, m7i-flex.large (2 vCPU, 8 GB), 30 GB encrypted disk, IMDSv2 only" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="inst"><mxGeometry x="20" y="516" width="840" height="18" as="geometry"/></mxCell><mxCell id="upsh" value="&lt;b&gt;infra/server/up.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;runs from /opt/relay/src&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;rebuilds and restarts the stack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;sets up the nightly backup&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="inst"><mxGeometry x="20" y="80" width="240" height="90" as="geometry"/></mxCell><mxCell id="c21" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="910" y="630" width="22" height="22" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;/opt/relay/.env&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;settings and random secrets&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;owner only&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="inst"><mxGeometry x="20" y="230" width="240" height="80" as="geometry"/></mxCell><mxCell id="backup" value="&lt;b&gt;Nightly backup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;cron, 3:30 AM Sri Lanka time&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;pg_dump, gzip, newest 14 kept&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;in /opt/relay-backups&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="inst"><mxGeometry x="20" y="370" w