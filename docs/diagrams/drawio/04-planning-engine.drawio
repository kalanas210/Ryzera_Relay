ng=0;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="22" height="22" as="geometry"/></mxCell><mxCell id="c29" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="310" width="22" height="22" as="geometry"/></mxCell><mxCell id="c30" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="310" width="22" height="22" as="geometry"/></mxCell><mxCell id="c31" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="320" y="650" width="22" height="22" as="geometry"/></mxCell><mxCell id="c32" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="580" width="22" height="22" as="geometry"/></mxCell><mxCell id="c33" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1040" y="650" width="22" height="22" as="geometry"/></mxCell><mxCell id="c34" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="650" width="22" height="22" as="geometry"/></mxCell><mxCell id="c35" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1180" y="310" width="22" height="22" as="geometry"/></mxCell><mxCell id="c36" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1580" y="310" width="22" height="22" as="geometry"/></mxCell><mxCell id="c37" value="Plain dataclasses go in and come out (relay_engine/model.py). The engine tests run on the seed's CSV files, with no database." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1500" height="20" as="geometry"/></mxCell><mxCell id="c38" value="Story day, Kandy hub: 57 orders, 18 trips carry 56 of them and one chilled order waits. A search takes about 23 to 31 seconds, so each answer is cached." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="1700" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Every trip, then the exact search" id="p2"><mxGraphModel dx="1870" dy="850" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1870" pageHeight="850" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1870" height="850" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Every trip, then the exact search&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1790" height="34" as="geometry"/></mxCell><mxCell id="c3" value="options.py lists every trip that could run. solver.py turns them into 0 or 1 choices and scipy.optimize.milp finds the best set." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1790" height="22" as="geometry"/></mxCell><mxCell id="opt" value="&lt;b style=&quot;font-size:14px&quot;&gt;options.py: every trip a vehicle could run&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFAE6;strokeColor=#C99700;strokeWidth=1.2;fontColor=#7A5B00;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1790" height="230" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;Group the orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;by brand, temperature and district&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;a trip never mixes groups&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;one list of trips for each group&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="opt"><mxGeometry x="20" y="50" width="400" height="150" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;Walk every set of stores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;12 orders or fewer in a group: every subset&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;more than 12: every set of up to 4 stores,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;then longer runs of the list&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="opt"><mxGeometry x="470" y="50" width="400" height="150" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;Keep a set only if it fits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;weight and volume fit the biggest available vehicle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;one order per store&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;trip minutes within 270 (Fresh) or 480 (Style, Tech)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;a departure from 2:00 AM to 8:00 AM (Fresh) or 5:00 PM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;keeps every store window&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;a set that breaks a limit stops growing&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="opt"><mxGeometry x="920" y="50" width="400" height="150" as="geometry"/></mxCell><mxCell id="o4" value="&lt;b&gt;Option&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the orders, and the stops in earliest-close order&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;weight, volume, minutes and km&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;earliest and preferred back, latest departure&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;handed to the solver as one list&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="opt"><mxGeometry x="1370" y="50" width="400" height="150" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="slv" value="&lt;b style=&quot;font-size:14px&quot;&gt;solver.py: Problem&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFAE6;strokeColor=#C99700;strokeWidth=1.2;fontColor=#7A5B00;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1250" height="290" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;which runs a vehicle may take&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;joint: usual runs, runs whose usual&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;vehicles are out, spares anywhere&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;usual: exactly each vehicle's usual runs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;open: any vehicle anywhere, for leftovers&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="slv"><mxGeometry x="20" y="50" width="280" height="210" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Slots&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;slot = vehicle, trip 1 or 2, and option&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;workshop and standby vehicles are left out&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;kept only if the vehicle can run it:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;weight, volume, van only, temperature,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;fuel left this week, latest departure&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="slv"><mxGeometry x="330" y="50" width="280" height="210" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;each order rides at most once&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;one first trip a vehicle, and a second&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;needs a first, leaving 10 minutes after&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the first is back&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Fresh minutes at most 270, daytime 480&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;fuel litres within the weekly quota left&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;second pass: at least the first count&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="slv"><mxGeometry x="640" y="50" width="280" height="210" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Two goals&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;served: carry the most orders&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;choice: the best of those, in this order&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;1. no early pull-out for a second trip&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;2. keep vehicles on their usual runs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;3. move the most kilograms&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;4. use fewer trips&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="slv"><mxGeometry x="950" y="50" width="280" height="210" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="milp" value="&lt;b style=&quot;font-size:14px&quot;&gt;scipy.optimize.milp&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="1340" y="420" width="490" height="290" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Solve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;integer variables, each 0 or 1, HiGHS inside&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;30 second limit a solve, 10 when explaining&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="milp"><mxGeometry x="20" y="50" width="450" height="100" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;Solution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the slots chosen and the orders they carry&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;usual runs kept and kilograms moved&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="milp"><mxGeometry x="20" y="180" width="450" height="80" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Options" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C99700;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8571428571428571;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o4" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610" y="385"/><mxPoint x="300" y="385"/></Array></mxGeometry></mxCell><mxCell id="c13" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="22" height="22" as="geometry"/></mxCell><mxCell id="c14" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="22" height="22" as="geometry"/></mxCell><mxCell id="c15" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="160" width="22" height="22" as="geometry"/></mxCell><mxCell id="c16" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1400" y="160" width="22" height="22" as="geometry"/></mxCell><mxCell id="c17" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="460" width="22" height="22" as="geometry"/></mxCell><mxCell id="c18" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="360" y="460" width="22" height="22" as="geometry"/></mxCell><mxCell id="c19" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="670" y="460" width="22" height="22" as="geometry"/></mxCell><mxCell id="c20" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="980" y="460" width="22" height="22" as="geometry"/></mxCell><mxCell id="c21" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="460" width="22" height="22" as="geometry"/></mxCell><mxCell id="c22" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="590" width="22" height="22" as="geometry"/></mxCell><mxCell id="c23" value="propose.py asks this several times for one depot: the most orders, the best allocation, and once more without each order it explains." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1700" height="20" as="geometry"/></mxCell><mxCell id="c24" value="A set stops growing once it breaks a limit, because adding a stop never makes a trip lighter, shorter or earlier." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1700" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1640" y="745" width="22" height="16" as="geometry"/></mxCell><mxCell id="c26" value="Relay's code" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1672" y="744" width="150" height="18" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1640" y="771" width="22" height="16" as="geometry"/></mxCell><mxCell id="c28" value="SciPy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1672" y="770" width="150" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Chilled and ambient plans" id="p3"><mxGraphModel dx="1870" dy="1260" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1870" pageHeight="1260" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1870" height="1260" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Chilled and ambient plans&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1790" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Chilled orders compete for few refrigerated vehicles, so they are planned exactly and every wait is explained. Ambient orders start from usual runs." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1790" height="22" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="30" width="22" height="16" as="geometry"/></mxCell><mxCell id="c5" value="A solve" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1332" y="29" width="190" height="18" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="56" width="22" height="16" as="geometry"/></mxCell><mxCell id="c7" value="A step with no solve" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1332" y="55" width="190" height="18" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1560" y="30" width="22" height="16" as="geometry"/></mxCell><mxCell id="c9" value="Unavoidable wait" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1592" y="29" width="190" height="18" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1560" y="56" width="22" height="16" as="geometry"/></mxCell><mxCell id="c11" value="Relay's choice" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1592" y="55" width="190" height="18" as="geometry"/></mxCell><mxCell id="chilled" value="&lt;b style=&quot;font-size:14px&quot;&gt;Chilled: planned exactly&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;propose.py, _plan_chilled&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFAE6;strokeColor=#C99700;strokeWidth=1.2;fontColor=#7A5B00;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1790" height="760" as="geometry"/></mxCell><mxCell id="ch0" value="&lt;b&gt;Chilled orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;with refrigerated vehicles&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Problem(scope = joint)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;usual runs, runs whose usual vehicles&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;are out, and spares anywhere&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="chilled"><mxGeometry x="20" y="60" width="240" height="130" as="geometry"/></mxCell><mxCell id="ch1" value="&lt;b&gt;Step 1: the most&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;solve(maximize = served)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;most = the most orders any&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;allocation can carry. The rest wait&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;in every allocation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="chilled"><mxGeometry x="330" y="60" width="310" height="130" as="geometry"/></mxCell><mxCell id="ch2" value="&lt;b&gt;Step 2: the best that keeps that many&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;solve(maximize = choice, min_served = most,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;force = the protected stores)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;if that finds nothing, solve again&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;without the force&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="chilled"><mxGeometry x="710" y="60" width="360" height="130" as="geometry"/></mxCell><mxCell id="ch3" value="&lt;b&gt;Does any order wait?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;no: return the slots, done&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;yes: analyse and explain&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="chilled"><mxGeometry x="1140" y="60" width="240" height="130" as="geometry"/></mxCell><mxCell id="ch4" value="&lt;b&gt;GroupAnalysis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;orders, max_served, protected&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;unavoidable = orders minus most&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;limiting: the depot's workshop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;vehicles&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="chilled"><mxGeometry x="1450" y="60" width="320" height="130" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch0" target="ch1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch1" target="ch2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch2" target="ch3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch3" target="ch4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="&lt;b&gt;Explain: solve again without each order&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;for each chilled order, 10 second limit:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;without it, can the rest still reach most?&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;no: it must ride, so it cannot be the one that waits&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;yes: it joins the pool, the orders that could wait&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="chilled"><mxGeometry x="20" y="280" width="470" height="190" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;Rank the pool by usual runs kept&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;for each order in the pool: the best choice&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;without it that still carries most orders&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;usual runs kept = the weekday shares of the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;usual runs it keeps, added up&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;pool_keeping_usual_runs: the pool orders&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;that keep the most usual runs&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="chilled"><mxGeometry x="550" y="280" width="420" height="190" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C99700;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5106382978723404;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch4" target="e1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="350"/><mxPoint x="300" y="350"/></Array></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st" value="&lt;b&gt;Story day, Kandy hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;23 chilled orders, two refrigerated vehicles in the workshop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;most = 22, so 1 order has to wait whatever Relay does&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;15 orders could be the one that waits (the pool)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;2 of the 15 keep the most usual runs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;1 of those 2 is a protected store, so the other waits: deferral rule 2&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="chilled"><mxGeometry x="20" y="550" width="950" height="170" as="geometry"/></mxCell><mxCell id="why" value="&lt;b style=&quot;font-size:14px&quot;&gt;Why each waiting order waits, checked in this order&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="chilled"><mxGeometry x="1010" y="270" width="760" height="470" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;No allocation that keeps every rule can carry it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;unavoidable, no rule: the pool is empty, or only this order,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;or no bigger than the number that must wait&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="why"><mxGeometry x="20" y="50" width="720" height="70" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Deferral rule 1: every other vehicle stays on its usual run&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;it is the only pool order whose wait keeps&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the most usual runs&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="why"><mxGeometry x="20" y="160" width="720" height="70" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Deferral rule 2: the other candidate's store waited last run&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the other orders that keep the most usual runs are protected stores,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;and a store never waits twice in a row without an override&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="why"><mxGeometry x="20" y="270" width="720" height="70" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Deferral rule 3: letting it wait keeps the most goods moving&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;none of the above applies: the allocation that moves&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the most kilograms left this order out&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEFD9;strokeColor=#A15C00;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="why"><mxGeometry x="20" y="380" width="720" height="70" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="e2" target="why"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="otherwise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="otherwise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="otherwise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="360" y="170" width="22" height="22" as="geometry"/></mxCell><mxCell id="c23" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="22" height="22" as="geometry"/></mxCell><mxCell id="c24" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1170" y="170" width="22" height="22" as="geometry"/></mxCell><mxCell id="c25" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="22" height="22" as="geometry"/></mxCell><mxCell id="c26" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="580" y="390" width="22" height="22" as="geometry"/></mxCell><mxCell id="c27" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14181F;strokeColor=#14181F;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1040" y="380" width="22" height="22" as="geometry"/></mxCell><mxCell id="ambient" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ambient: each vehicle's usual run first&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;propose.py, _plan_ambient&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFAE6;strokeColor=#C99700;strokeWidth=1.2;fontColor=#7A5B00;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1790" height="230" as="geometry"/></mxCell><mxCell id="d0" value="&lt;b&gt;Ambient orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;with the other vehicles&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;options.py lists the trips&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;solver.py searches&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ambient"><mxGeometry x="20" y="50" width="250" height="150" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;First: the usual runs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Problem(scope = usual, first trips keep their usual departure)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;each vehicle takes exactly its usual runs: the stores&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;it usually serves that ordered today&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;solve served, then solve choice keeping that many&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ambient"><mxGeometry x="330" y="50" width="480" height="150" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Then: the leftovers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;Problem(scope = open) for orders with no trip&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;vehicles with fewer than 2 trips; one with a trip may add&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;a second, leaving 10 minutes after the first is back&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;a second trip that makes a first leave early costs the most&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;solve served, then solve choice, as before&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ambient"><mxGeometry x="870" y="50" width="520" height="150" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Still no trip: it waits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;unavoidable, no rule&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&quot;No free ambient vehicle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;can carry it in time&quot;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="ambient"><mxGeometry x="1450" y="50" width="320" height="150" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="The three deferral rules are Relay's own and separate from the eleven operating rules. A deferred order waits for the next run and the dispatcher confirms the reason." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="1700" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="The engine cache" id="p4"><mxGraphModel dx="1870" dy="1280" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1870" pageHeight="1280" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;locked=1;connectable=0;movable=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1870" height="1280" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;The engine cache&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=28;fontFamily=Helvetica;fontColor=#14181F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1790" height="34" as="geometry"/></mxCell><mxCell id="c3" value="One search per distinct question. The answer is stored under a hash of everything the engine reads and of the engine's own source." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#69727F;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1790" height="22" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="30" width="22" height="16" as="geometry"/></mxCell><mxCell id="c5" value="API code" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1332" y="29" width="190" height="18" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="56" width="22" height="16" as="geometry"/></mxCell><mxCell id="c7" value="relay_engine" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1332" y="55" width="190" height="18" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="82" width="22" height="16" as="geometry"/></mxCell><mxCell id="c9" value="Database" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1332" y="81" width="190" height="18" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1560" y="30" width="22" height="16" as="geometry"/></mxCell><mxCell id="c11" value="Cache hit" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1592" y="29" width="190" height="18" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#69727F;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1560" y="56" width="22" height="16" as="geometry"/></mxCell><mxCell id="c13" value="Warm-up job" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1592" y="55" width="190" height="18" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F1F3;strokeColor=#0F5563;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1560" y="82" width="22" height="16" as="geometry"/></mxCell><mxCell id="c15" value="Screen" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#3A424E;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1592" y="81" width="190" height="18" as="geometry"/></mxCell><mxCell id="top" value="&lt;b style=&quot;font-size:14px&quot;&gt;propose_cached&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;services/engine_cache.py, called by propose_plan and the override preview&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1790" height="700" as="geometry"/></mxCell><mxCell id="cyl" value="&lt;b&gt;engine_cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;key, depot, created_at, result&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;shared by every copy of the day&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="750" y="50" width="280" height="130" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;The run, made canonical&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;network, orders, vehicles, usual runs,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;conditions, protected stores&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;sets and maps sorted, floats to 6 places&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="20" y="210" width="330" height="110" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;The engine's own source&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;engine_fingerprint(): SHA-256 over the name&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;and bytes of every .py file in relay_engine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;worked out once per process&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="20" y="340" width="330" height="110" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;The key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;SHA-256 of both, as JSON&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;64 hex characters&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;change an input or an engine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;file and the key changes&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="410" y="240" width="250" height="140" as="geometry"/></mxCell><mxCell id="lk" value="&lt;b&gt;Look up the key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;db.get(EngineCache, key)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;is there a row?&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="750" y="240" width="280" height="140" as="geometry"/></mxCell><mxCell id="hit" value="&lt;b&gt;Hit: return it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;decode the stored JSON into&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;trips, deferred and analyses&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;no search at all&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#1F7A4D;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="1120" y="240" width="270" height="140" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1" target="k"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="i2" target="k"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k" target="lk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="look up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0A6EBD;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk" target="cyl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="hit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F7A4D;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk" target="hit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1" value="&lt;b&gt;A connection of its own&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;one transaction, apart from the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;request's session, so the answer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;and the unlock happen together&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="20" y="500" width="250" height="150" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Take the lock for this key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;pg_advisory_xact_lock(7101, key)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the first 4 bytes of the key&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;one search per key: others wait here&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="330" y="500" width="270" height="150" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Look again&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;someone may have stored the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;answer while this one waited:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;if so, return it&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="660" y="500" width="270" height="150" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;The search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;propose(run) in relay_engine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;about 23 to 31 seconds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;on the story day&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#C99700;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="990" y="500" width="240" height="150" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;Store the row&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;insert into engine_cache,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;on conflict do nothing&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E4F1FB;strokeColor=#0A6EBD;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="1290" y="500" width="240" height="150" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b&gt;Commit, return&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;row stored and lock&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;released together,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;then the Answer&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="top"><mxGeometry x="1590" y="500" width="180" height="150" as="geometry"/></mxCell><mxCell id="c21" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C99700;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.48;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="590"/><mxPoint x="180" y="590"/></Array></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0A6EBD;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;dashed=1;dashPattern=6 4;exitX=0.875;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="cyl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="235"/></Array></mxGeometry></mxCell><mxCell id="warm" value="&lt;b style=&quot;font-size:14px&quot;&gt;The warm-up&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;&amp;nbsp;&amp;nbsp;a separate process, not a thread: the search is heavy and requests keep the GIL&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#B8BFC9;strokeWidth=1.2;fontColor=#3A424E;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1790" height="330" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;relay-api serve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;starts a daemon process, relay-warm,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;beside Uvicorn (cli.py)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="warm"><mxGeometry x="20" y="60" width="300" height="130" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Hold a shared lock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;pg_advisory_xact_lock_shared(7102, 0)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;for as long as the warm-up runs&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="warm"><mxGeometry x="380" y="60" width="300" height="130" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;Play a scratch copy to the plan moment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the story proposes the Kandy hub on the way&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;a workspace named Engine cache warm-up&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="warm"><mxGeometry x="740" y="60" width="330" height="130" as="geometry"/></mxCell><mxCell id="w4" value="&lt;b&gt;Propose Peliyagoda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;planning.propose_plan on&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;the scratch copy, answer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;stored in engine_cache&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="warm"><mxGeometry x="1130" y="60" width="260" height="130" as="geometry"/></mxCell><mxCell id="w5" value="&lt;b&gt;Delete the scratch copy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;about a minute on a new database,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#69727F&quot;&gt;so a judge's first Propose is a hit&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A424E;fontColor=#14181F;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="warm"><mxGeometry x="1450" y="60" width="320" height="130" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundColor=#FFFFFF;endSize=6;startSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3A424E;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=12;fontFamily=Helvetica;fontColor=#3A424E;labelBackgroundC