# SITE_ADDRESS is ":80" locally. Set it to a domain in production and Caddy provisions HTTPS itself,
# which the installable app, the camera and location need.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			# live updates stream as server-sent events
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@sw path /sw.js /registerSW.js /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		-Server
	}
}
