# SITE_ADDRESS is :80 locally. In production it is a domain and Caddy gets HTTPS itself.
# The installable app, the camera and location need HTTPS.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		# The biggest upload is a photo, shrunk on the phone and capped at 1.5 MB by the API.
		# Anything bigger gets a 413 here before the API reads it.
		request_body {
			max_size 2MB
		}
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@sw path /sw.js /registerSW.js /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		-Server
	}
}
